{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omnidoc.local/schemas/review-m0-integration-selector.json",
  "title": "OmniDoc Review M0 integration selector",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contractVersion",
    "state",
    "adapterId",
    "testClasses",
    "targetSelectors",
    "staticScanRoots",
    "evidenceSystemProperty",
    "pendingReasons"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "contractVersion": {"const": "REVIEW_M0_CONTRACT_V1"},
    "state": {"enum": ["PENDING_INTEGRATION", "READY"]},
    "adapterId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
    "testClasses": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-zA-Z_$][a-zA-Z0-9_$]*(\\.[a-zA-Z_$][a-zA-Z0-9_$]*)+$"}
    },
    "targetSelectors": {
      "type": "object",
      "minProperties": 15,
      "maxProperties": 15,
      "propertyNames": {"pattern": "^M0-P0-[0-9]{3}$"},
      "additionalProperties": {"$ref": "#/$defs/targetSelector"}
    },
    "staticScanRoots": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^(?![A-Za-z]:)(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$)).+"}
    },
    "evidenceSystemProperty": {"const": "review.m0.acceptance.evidence.path"},
    "pendingReasons": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
  },
  "$defs": {
    "targetSelector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["className", "methodName"],
      "properties": {
        "className": {"type": "string"},
        "methodName": {"type": "string", "pattern": "^[a-zA-Z_$][a-zA-Z0-9_$]*$"}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"state": {"const": "PENDING_INTEGRATION"}}, "required": ["state"]},
      "then": {
        "properties": {
          "pendingReasons": {"minItems": 1}
        }
      }
    },
    {
      "if": {"properties": {"state": {"const": "READY"}}, "required": ["state"]},
      "then": {
        "properties": {
          "pendingReasons": {"maxItems": 0}
        }
      }
    }
  ]
}
