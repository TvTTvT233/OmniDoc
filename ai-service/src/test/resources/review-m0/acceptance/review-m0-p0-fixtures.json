{
  "schemaVersion": 1,
  "fixtureSetId": "review-m0-p0-contract-v1",
  "synthetic": true,
  "containsRealUserData": false,
  "requiredTargetIds": [
    "M0-P0-001",
    "M0-P0-002",
    "M0-P0-003",
    "M0-P0-004",
    "M0-P0-005",
    "M0-P0-006",
    "M0-P0-007",
    "M0-P0-008",
    "M0-P0-009",
    "M0-P0-010",
    "M0-P0-011",
    "M0-P0-012",
    "M0-P0-013",
    "M0-P0-014",
    "M0-P0-015"
  ],
  "scenarios": [
    {
      "id": "m0-checklist-unconfirmed-blocks-review",
      "targetId": "M0-P0-001",
      "given": {"checklistLifecycle": "CANDIDATE_DRAFT", "requestedAction": "START_REVIEW"},
      "expect": {"actionAllowed": false, "errorCode": "REVIEW_M0_CHECKLIST_NOT_CONFIRMED", "reviewCreated": false}
    },
    {
      "id": "m0-checklist-confirmed-allows-review",
      "targetId": "M0-P0-001",
      "given": {"checklistLifecycle": "CONFIRMED", "requestedAction": "START_REVIEW"},
      "expect": {"actionAllowed": true}
    },
    {
      "id": "m0-official-rule-requires-anchor",
      "targetId": "M0-P0-002",
      "given": {"origin": "OFFICIAL_EXTRACTED", "authorship": "EXTRACTED_TEXT", "sourceRefs": []},
      "expect": {"acceptedAsOfficialExtracted": false, "checklistPublished": false, "definitiveFindingAllowed": false}
    },
    {
      "id": "m0-official-rule-with-dual-anchors",
      "targetId": "M0-P0-002",
      "given": {"origin": "OFFICIAL_EXTRACTED", "authorship": "EXTRACTED_TEXT", "sourceRefs": [{"basisId": "basis-synthetic-01", "sourceLocator": {"page": 1, "block": "paragraph-4"}}], "materialEvidenceKind": "MATERIAL_SET_SNAPSHOT"},
      "expect": {"acceptedAsOfficialExtracted": true, "definitiveFindingAllowed": true}
    },
    {
      "id": "m0-user-added-rule-remains-user",
      "targetId": "M0-P0-002",
      "given": {"origin": "USER_ADDED", "authorship": "USER_REWRITTEN", "text": "Synthetic user rule"},
      "expect": {"storedOrigin": "USER_ADDED", "storedAuthorship": "USER_REWRITTEN", "official": false}
    },
    {
      "id": "m0-user-rewrite-does-not-become-official",
      "targetId": "M0-P0-002",
      "given": {"origin": "OFFICIAL_EXTRACTED", "authorship": "USER_REWRITTEN", "sourceRefs": [{"basisId": "basis-synthetic-01", "sourceLocator": {"page": 1, "block": "paragraph-4"}}]},
      "expect": {"storedOrigin": "OFFICIAL_EXTRACTED", "storedAuthorship": "USER_REWRITTEN", "officialTextClaimed": false, "sourceRefsRetained": true}
    },
    {
      "id": "m0-upload-open-cannot-be-missing",
      "targetId": "M0-P0-003",
      "given": {"uploadCompletion": "UNCONFIRMED", "expectedMaterialPresent": false},
      "expect": {"reviewCreated": false, "missingCount": 0, "errorCode": "REVIEW_M0_UPLOAD_NOT_CONFIRMED"}
    },
    {
      "id": "m0-upload-confirmed-can-be-missing",
      "targetId": "M0-P0-003",
      "given": {"uploadCompletion": "CONFIRMED", "expectedMaterialPresent": false},
      "expect": {"classification": "MISSING", "ruleEvidenceKinds": ["USER_RULE_REVISION"], "materialEvidenceKinds": ["MATERIAL_SET_SNAPSHOT"]}
    },
    {
      "id": "m0-encrypted-file-cannot-confirm",
      "targetId": "M0-P0-004",
      "given": {"parseState": "ENCRYPTED"},
      "expect": {"classification": "CANNOT_CONFIRM", "reasonCode": "ENCRYPTED"}
    },
    {
      "id": "m0-corrupt-file-cannot-confirm",
      "targetId": "M0-P0-004",
      "given": {"parseState": "CORRUPTED"},
      "expect": {"classification": "CANNOT_CONFIRM", "reasonCode": "CORRUPTED"}
    },
    {
      "id": "m0-ocr-failure-cannot-confirm",
      "targetId": "M0-P0-004",
      "given": {"subjectType": "OFFICIAL_BASIS", "parseState": "OCR_INSUFFICIENT"},
      "expect": {"classification": "CANNOT_CONFIRM", "reasonCode": "OCR_INSUFFICIENT"}
    },
    {
      "id": "m0-explicit-naming-rule-is-deterministic",
      "targetId": "M0-P0-005",
      "given": {"ruleKind": "EXACT", "pattern": "application_demo-01.pdf", "caseSensitive": true, "submissionFileName": "application_demo-01.pdf"},
      "expect": {"definitiveFindingAllowed": true, "matches": true}
    },
    {
      "id": "m0-invalid-naming-rule-blocks-publication",
      "targetId": "M0-P0-005",
      "given": {"ruleKind": "EXACT", "pattern": "demo.pdf", "caseSensitive": null},
      "expect": {"checklistPublished": false, "definitiveFindingAllowed": false, "errorCode": "REVIEW_M0_REQUEST_INVALID"}
    },
    {
      "id": "m0-download-copy-renames-only-submission-name",
      "targetId": "M0-P0-006",
      "given": {
        "before": {"original": "synthetic-original.pdf", "objectKey": "review-m0/object/001", "contentHash": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "submissionFileName": "synthetic-original.pdf"},
        "requestedSubmissionFileName": "application_demo-01.pdf"
      },
      "expect": {
        "after": {"original": "synthetic-original.pdf", "objectKey": "review-m0/object/001", "contentHash": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "submissionFileName": "application_demo-01.pdf"},
        "downloadIsDerivedCopy": true
      }
    },
    {
      "id": "m0-ignored-item-remains-not-ready",
      "targetId": "M0-P0-007",
      "given": {"decision": "IGNORE", "requestedAssessment": "M0_READY"},
      "expect": {"itemRetained": true, "transitionAllowed": false, "decision": "IGNORE", "assessment": "M0_NOT_READY"}
    },
    {
      "id": "m0-idempotent-repeat-has-one-result",
      "targetId": "M0-P0-008",
      "given": {"operationKey": "synthetic-operation-01", "attempts": 3},
      "expect": {"createdResults": 1, "duplicateResults": 0, "sameResultIdentity": true}
    },
    {
      "id": "m0-recovery-resumes-from-checkpoint",
      "targetId": "M0-P0-009",
      "given": {"checkpoint": "EXTRACTED", "interruption": "SYNTHETIC_RESTART"},
      "expect": {"resumeFrom": "EXTRACTED", "reprocessedCompletedStages": 0, "duplicateResults": 0}
    },
    {
      "id": "m0-incremental-review-changed-file-only",
      "targetId": "M0-P0-010",
      "given": {"changedMaterialIds": ["material-synthetic-02"], "unchangedMaterialIds": ["material-synthetic-01"]},
      "expect": {"reReviewedMaterialIds": ["material-synthetic-02"], "reusedMaterialIds": ["material-synthetic-01"]}
    },
    {
      "id": "m0-old-result-becomes-outdated",
      "targetId": "M0-P0-010",
      "given": {"reviewSnapshot": "snapshot-01", "currentSnapshot": "snapshot-02"},
      "expect": {"freshness": "OUTDATED", "m0Ready": false}
    },
    {
      "id": "m0-cross-user-read-is-hidden",
      "targetId": "M0-P0-011",
      "given": {"owner": "synthetic-user-a", "requester": "synthetic-user-b", "operation": "READ"},
      "expect": {"allowed": false, "publicErrorCode": "REVIEW_M0_RESOURCE_NOT_FOUND"}
    },
    {
      "id": "m0-cross-user-download-is-hidden",
      "targetId": "M0-P0-011",
      "given": {"owner": "synthetic-user-a", "requester": "synthetic-user-b", "operation": "DOWNLOAD_COPY"},
      "expect": {"allowed": false, "publicErrorCode": "REVIEW_M0_RESOURCE_NOT_FOUND"}
    },
    {
      "id": "m0-sensitive-fields-not-in-report",
      "targetId": "M0-P0-012",
      "given": {"fields": ["original", "objectKey", "contentHash", "ocrText", "documentContent", "credential"]},
      "expect": {"allowedInMachineReport": [], "staticLeakCount": 0}
    },
    {
      "id": "m0-forbidden-conclusions-absent",
      "targetId": "M0-P0-013",
      "given": {"m0Stage": true},
      "expect": {"forbiddenConclusionKinds": ["TYPO", "UNFILLED_FIELD", "ELIGIBILITY", "STAMP_AUTHENTICITY", "STAMP_DATE", "CROSS_MATERIAL_CONSISTENCY", "PROOF_SUPPORT", "CONTENT_QUALITY"], "emittedCount": 0}
    },
    {
      "id": "m0-formal-formats-have-deterministic-disposition",
      "targetId": "M0-P0-014",
      "given": {"manifestSection": "formalFormats"},
      "expect": {"requiredFormats": ["PDF", "DOCX", "XLSX", "JPG", "PNG", "ZIP"], "unsupportedRequiredFormats": 0}
    },
    {
      "id": "m0-zip-boundaries-fail-closed",
      "targetId": "M0-P0-015",
      "given": {"manifestSection": "zipBoundaries"},
      "expect": {"unsafeAccepted": 0, "unknownClassifiedMissing": 0}
    }
  ],
  "formalFormats": [
    {"format": "PDF", "extension": ".pdf", "mediaType": "application/pdf", "signatureHex": "25504446", "expectedDisposition": "ACCEPT", "containerOnly": false},
    {"format": "DOCX", "extension": ".docx", "mediaType": "application/vnd.openxmlformats-officedocument.wordprocessingml.document", "signatureHex": "504B0304", "expectedDisposition": "ACCEPT", "containerOnly": false},
    {"format": "XLSX", "extension": ".xlsx", "mediaType": "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", "signatureHex": "504B0304", "expectedDisposition": "ACCEPT", "containerOnly": false},
    {"format": "JPG", "extension": ".jpg", "mediaType": "image/jpeg", "signatureHex": "FFD8FFE0", "expectedDisposition": "ACCEPT", "containerOnly": false, "variant": "JFIF"},
    {"format": "PNG", "extension": ".png", "mediaType": "image/png", "signatureHex": "89504E470D0A1A0A", "expectedDisposition": "ACCEPT", "containerOnly": false},
    {"format": "ZIP", "extension": ".zip", "mediaType": "application/zip", "signatureHex": "504B0304", "expectedDisposition": "ACCEPT", "containerOnly": true, "allowedLeafFormats": ["PDF", "DOCX", "XLSX", "JPG", "PNG"]}
  ],
  "zipBoundaries": [
    {"id": "zip-safe-flat-archive", "condition": "bounded flat entries with matching signatures", "expectedDisposition": "ACCEPT", "reasonCode": null},
    {"id": "zip-parent-traversal", "condition": "entry path contains parent traversal", "expectedDisposition": "CANNOT_CONFIRM", "reasonCode": "ARCHIVE_SAFETY_LIMIT_EXCEEDED"},
    {"id": "zip-absolute-path", "condition": "entry path is absolute", "expectedDisposition": "CANNOT_CONFIRM", "reasonCode": "ARCHIVE_SAFETY_LIMIT_EXCEEDED"},
    {"id": "zip-symlink-entry", "condition": "entry is a symbolic link", "expectedDisposition": "CANNOT_CONFIRM", "reasonCode": "ARCHIVE_SAFETY_LIMIT_EXCEEDED"},
    {"id": "zip-expanded-size-limit", "condition": "expanded bytes exceed configured bound", "expectedDisposition": "CANNOT_CONFIRM", "reasonCode": "ARCHIVE_SAFETY_LIMIT_EXCEEDED"},
    {"id": "zip-compression-ratio-limit", "condition": "compression ratio exceeds configured bound", "expectedDisposition": "CANNOT_CONFIRM", "reasonCode": "ARCHIVE_SAFETY_LIMIT_EXCEEDED"},
    {"id": "zip-entry-count-limit", "condition": "entry count exceeds configured bound", "expectedDisposition": "CANNOT_CONFIRM", "reasonCode": "ARCHIVE_SAFETY_LIMIT_EXCEEDED"},
    {"id": "zip-nested-archive", "condition": "nested archive is present", "expectedDisposition": "CANNOT_CONFIRM", "reasonCode": "NESTED_ARCHIVE_NOT_ALLOWED"},
    {"id": "zip-encrypted-entry", "condition": "entry is encrypted", "expectedDisposition": "CANNOT_CONFIRM", "reasonCode": "ENCRYPTED"},
    {"id": "zip-normalized-duplicate", "condition": "two names normalize to the same output path", "expectedDisposition": "CANNOT_CONFIRM", "reasonCode": "ARCHIVE_SAFETY_LIMIT_EXCEEDED"},
    {"id": "zip-extension-signature-mismatch", "condition": "entry extension and signature disagree", "expectedDisposition": "CANNOT_CONFIRM", "reasonCode": "TYPE_MISMATCH"}
  ]
}
