{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omnidoc.local/schemas/review-m0-integrated-evidence.json",
  "title": "OmniDoc Review M0 integrated aggregate evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "contractVersion", "adapterId", "targetResults", "gates", "contentSafety"],
  "properties": {
    "schemaVersion": {"const": 1},
    "contractVersion": {"const": "review-m0-v1"},
    "adapterId": {"type": "string"},
    "targetResults": {
      "type": "object",
      "minProperties": 15,
      "maxProperties": 15,
      "propertyNames": {"pattern": "^M0-P0-[0-9]{3}$"},
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status", "assertions"],
        "properties": {
          "status": {"const": "PASS"},
          "assertions": {"type": "integer", "minimum": 1}
        }
      }
    },
    "gates": {"$ref": "review-m0-acceptance-report.schema.json#/properties/gates"},
    "contentSafety": {"$ref": "review-m0-acceptance-report.schema.json#/properties/contentSafety"}
  }
}
