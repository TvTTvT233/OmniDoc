{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omnidoc.local/schemas/review-m0-acceptance-report.json",
  "title": "OmniDoc Review M0 acceptance report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contractVersion",
    "mode",
    "status",
    "productionVerified",
    "generatedAtUtc",
    "environment",
    "fixture",
    "selector",
    "tests",
    "coverage",
    "gates",
    "contentSafety",
    "unverified"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "contractVersion": {"const": "review-m0-v1"},
    "mode": {"enum": ["ASSET", "INTEGRATED"]},
    "status": {"enum": ["ASSET_VERIFIED", "PENDING_INTEGRATION", "AUTO_VERIFIED", "FAILED"]},
    "productionVerified": {"type": "boolean"},
    "generatedAtUtc": {"type": "string", "format": "date-time"},
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["branch", "head", "os", "java", "externalNetworkIncluded"],
      "properties": {
        "branch": {"type": "string"},
        "head": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "os": {"type": "string"},
        "java": {"type": "string"},
        "externalNetworkIncluded": {"const": false}
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "synthetic", "containsRealUserData"],
      "properties": {
        "id": {"const": "review-m0-p0-contract-v1"},
        "synthetic": {"const": true},
        "containsRealUserData": {"const": false}
      }
    },
    "selector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "adapterId", "requiredTargets", "missing"],
      "properties": {
        "state": {"enum": ["PENDING_INTEGRATION", "READY"]},
        "adapterId": {"type": ["string", "null"]},
        "requiredTargets": {"type": "integer", "const": 15},
        "missing": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
      }
    },
    "tests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run", "failures", "errors", "skipped", "asset", "integrated"],
      "properties": {
        "run": {"type": "integer", "minimum": 0},
        "failures": {"type": "integer", "minimum": 0},
        "errors": {"type": "integer", "minimum": 0},
        "skipped": {"type": "integer", "minimum": 0},
        "asset": {"$ref": "#/$defs/counts"},
        "integrated": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/counts"}]}
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requiredP0Targets", "assetTargetsCovered", "integratedTargetsPassed", "formalFormats", "zipBoundaryCases"],
      "properties": {
        "requiredP0Targets": {"const": 15},
        "assetTargetsCovered": {"const": 15},
        "integratedTargetsPassed": {"type": ["integer", "null"], "minimum": 0, "maximum": 15},
        "formalFormats": {"const": 6},
        "zipBoundaryCases": {"type": "integer", "minimum": 9}
      }
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inventoryUnconfirmedReviewAttempts",
        "unanchoredOfficialFindings",
        "userRulesClaimedOfficial",
        "missingBeforeUploadConfirmation",
        "unreadableClassifiedMissing",
        "ambiguousNamingDefinitiveFindings",
        "identityMutations",
        "ignoredReadyTransitions",
        "idempotencyDuplicates",
        "recoveryDuplicates",
        "staleSnapshotsNotOutdated",
        "successfulCrossUserAccess",
        "sensitivePayloadLeaks",
        "forbiddenM0Conclusions",
        "formalFormatFailures",
        "unsafeZipAccepted"
      ],
      "properties": {
        "inventoryUnconfirmedReviewAttempts": {"type": ["integer", "null"], "minimum": 0},
        "unanchoredOfficialFindings": {"type": ["integer", "null"], "minimum": 0},
        "userRulesClaimedOfficial": {"type": ["integer", "null"], "minimum": 0},
        "missingBeforeUploadConfirmation": {"type": ["integer", "null"], "minimum": 0},
        "unreadableClassifiedMissing": {"type": ["integer", "null"], "minimum": 0},
        "ambiguousNamingDefinitiveFindings": {"type": ["integer", "null"], "minimum": 0},
        "identityMutations": {"type": ["integer", "null"], "minimum": 0},
        "ignoredReadyTransitions": {"type": ["integer", "null"], "minimum": 0},
        "idempotencyDuplicates": {"type": ["integer", "null"], "minimum": 0},
        "recoveryDuplicates": {"type": ["integer", "null"], "minimum": 0},
        "staleSnapshotsNotOutdated": {"type": ["integer", "null"], "minimum": 0},
        "successfulCrossUserAccess": {"type": ["integer", "null"], "minimum": 0},
        "sensitivePayloadLeaks": {"type": ["integer", "null"], "minimum": 0},
        "forbiddenM0Conclusions": {"type": ["integer", "null"], "minimum": 0},
        "formalFormatFailures": {"type": ["integer", "null"], "minimum": 0},
        "unsafeZipAccepted": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "contentSafety": {
      "type": "object",
      "additionalProperties": false,
      "required": ["containsDocumentContent", "containsOcrText", "containsObjectKey", "containsPersonalIdentifier", "containsCredential"],
      "properties": {
        "containsDocumentContent": {"const": false},
        "containsOcrText": {"const": false},
        "containsObjectKey": {"const": false},
        "containsPersonalIdentifier": {"const": false},
        "containsCredential": {"const": false}
      }
    },
    "unverified": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
  },
  "$defs": {
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run", "failures", "errors", "skipped", "reports"],
      "properties": {
        "run": {"type": "integer", "minimum": 0},
        "failures": {"type": "integer", "minimum": 0},
        "errors": {"type": "integer", "minimum": 0},
        "skipped": {"type": "integer", "minimum": 0},
        "reports": {"type": "integer", "minimum": 0}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "ASSET_VERIFIED"}}, "required": ["status"]},
      "then": {
        "properties": {
          "mode": {"const": "ASSET"},
          "productionVerified": {"const": false},
          "tests": {
            "properties": {
              "failures": {"const": 0},
              "errors": {"const": 0},
              "skipped": {"const": 0},
              "integrated": {"type": "null"}
            }
          },
          "coverage": {"properties": {"integratedTargetsPassed": {"type": "null"}}}
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "PENDING_INTEGRATION"}}, "required": ["status"]},
      "then": {
        "properties": {
          "mode": {"const": "INTEGRATED"},
          "productionVerified": {"const": false},
          "selector": {"properties": {"state": {"const": "PENDING_INTEGRATION"}}, "required": ["state"]},
          "tests": {
            "properties": {
              "failures": {"const": 0},
              "errors": {"const": 0},
              "skipped": {"const": 0},
              "integrated": {"type": "null"}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "AUTO_VERIFIED"}}, "required": ["status"]},
      "then": {
        "properties": {
          "mode": {"const": "INTEGRATED"},
          "productionVerified": {"const": true},
          "selector": {
            "properties": {"state": {"const": "READY"}, "missing": {"maxItems": 0}},
            "required": ["state", "missing"]
          },
          "tests": {
            "properties": {
              "failures": {"const": 0},
              "errors": {"const": 0},
              "skipped": {"const": 0},
              "integrated": {"$ref": "#/$defs/counts"}
            }
          },
          "coverage": {"properties": {"integratedTargetsPassed": {"const": 15}}},
          "gates": {
            "properties": {
              "inventoryUnconfirmedReviewAttempts": {"const": 0},
              "unanchoredOfficialFindings": {"const": 0},
              "userRulesClaimedOfficial": {"const": 0},
              "missingBeforeUploadConfirmation": {"const": 0},
              "unreadableClassifiedMissing": {"const": 0},
              "ambiguousNamingDefinitiveFindings": {"const": 0},
              "identityMutations": {"const": 0},
              "ignoredReadyTransitions": {"const": 0},
              "idempotencyDuplicates": {"const": 0},
              "recoveryDuplicates": {"const": 0},
              "staleSnapshotsNotOutdated": {"const": 0},
              "successfulCrossUserAccess": {"const": 0},
              "sensitivePayloadLeaks": {"const": 0},
              "forbiddenM0Conclusions": {"const": 0},
              "formalFormatFailures": {"const": 0},
              "unsafeZipAccepted": {"const": 0}
            }
          },
          "unverified": {"maxItems": 0}
        }
      }
    },
    {
      "if": {"properties": {"status": {"enum": ["ASSET_VERIFIED", "PENDING_INTEGRATION", "FAILED"]}}, "required": ["status"]},
      "then": {"properties": {"productionVerified": {"const": false}}}
    }
  ]
}
